{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Skill Card",
  "type": "object",
  "required": [
    "skill_id",
    "name",
    "definition",
    "business_trigger",
    "mastery_target"
  ],
  "properties": {
    "skill_id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "definition": {
      "type": "string"
    },
    "business_trigger": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "diagnosis_steps": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "metrics": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "execution": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "common_errors": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "mastery_target": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5
    }
  }
}